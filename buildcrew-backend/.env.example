# Copy to .env (gitignored) and fill with your Supabase project's Postgres credentials.
# Quarkus automatically loads a .env file from this directory in dev mode.

SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
